#!/usr/bin/env -S uv run --script
# uv (not pip) so `cursor-sdk` installs cleanly everywhere, including macOS
# Homebrew Python, whose externally-managed-environment guard rejects a bare
# `pip install`.
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     # Pin by hand after checking the cursor-sdk changelog.
#     "cursor-sdk==1.0.24",
# ]
#
# [tool.uv]
# # Transitive cooldown; cursor-sdk exempt so a fresh pin installs immediately.
# exclude-newer = "1 week"
# exclude-newer-package = { cursor-sdk = false }
# ///
"""Propose an upstream grammar update for a single language.

It wraps `scripts/update-grammar`, with the following orchestration:

  * resolve each grammar's latest *stable* release tag (never an in-flux
    upstream `master` commit),
  * bump to it via `update-grammar --skip-release`,
  * regenerate the corpus snapshots a grammar bump invariably churns and
    re-run `test-lang` for an authoritative pass/fail,
  * open one PR in *this* repo when there's a real, green update,
  * and clean up after itself so a failure never leaks into the next run.

Modes:
  propose-grammar-update --list-languages [--json]
      Print the set of proposable languages (one per line, or a JSON
      array for the workflow matrix).
  propose-grammar-update <language> --resolve-tag-only
      Print the latest stable tag for <language> and exit (no mutation).
  propose-grammar-update <language> [--open-pr] [--dry-run] [--language-agent]
      Bump <language> to its latest tag, regenerate snapshots, test, and
      emit a JSON result. With --open-pr, also create the PR; --dry-run
      prints the would-be PR instead of pushing. --language-agent dispatches
      a Cursor agent with fix-semgrep-grammar if test-lang fails.
  propose-grammar-update <language> --release [--result FILE]
      Create a PR to semgrep-<lang>. semgrep-proprietary integration is left to
      the existing Cursor workflow on that repo.

Environment variables:
  GH_TOKEN / GITHUB_TOKEN   Required by every `gh` call (PR/label create,
                            repo lookups). --release needs broader creds
                            (push to semgrep-<lang>) than --open-pr.
  CURSOR_API_KEY            Required only with --language-agent; read by the
                            cursor_sdk itself, never by this script.
  CURSOR_MODEL              Model for the language agent (default: "auto").
  GRAMMAR_BASE_BRANCH       Base branch for grammar-update PRs
                            (default: "main").
"""

from __future__ import annotations

import argparse
import contextlib
import filecmp
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import asdict, dataclass, fields
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path
from typing import Any, Callable

###############################################################################
# update-grammar import #
###############################################################################

# `update-grammar` has no extension, so it can't be imported normally. Load it
# the same way scripts/test_update_grammar.py does and reuse its helpers
# instead of duplicating language-discovery / version-file logic.
_SCRIPT_DIR = Path(__file__).resolve().parent
_UPDATE_GRAMMAR_PATH = _SCRIPT_DIR / "update-grammar"


def _load_update_grammar() -> Any:
    """Load `update-grammar` as a module (it has no extension to import normally)."""
    loader = SourceFileLoader("update_grammar", str(_UPDATE_GRAMMAR_PATH))
    spec = spec_from_loader("update_grammar", loader)
    module = module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


ug = _load_update_grammar()

# `lang/ts_versions.py` resolves the tree-sitter version pinned for a given
# grammar directory (lang/languages-*, lang/language-variants-*).
_TS_VERSIONS_PATH = _SCRIPT_DIR.parent / "lang" / "ts_versions.py"


def _load_ts_versions() -> Any:
    """Load `lang/ts_versions.py` as a module."""
    loader = SourceFileLoader("ts_versions", str(_TS_VERSIONS_PATH))
    spec = spec_from_loader("ts_versions", loader)
    module = module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


ts_versions = _load_ts_versions()

# cursor_agent_runner.py has a normal extension and no top-level cursor_sdk
# import, so a plain import works once its directory is on sys.path.
sys.path.insert(0, str(_SCRIPT_DIR))
from cursor_agent_runner import (  # noqa: E402
    DEFAULT_AGENT_TOKEN_CAP,
    DEFAULT_AGENT_TURN_CAP,
    DEFAULT_AGENT_TIMEOUT,
    cap_or_none,
    ensure_cursor_sdk,
    parse_duration_seconds,
    run_language_agent,
)

###############################################################################
# Types #
###############################################################################

# Result statuses, in the JSON contract emitted on stdout:
#   updated  - submodule moved to a newer tag and test-lang passed
#   no-op    - already at the latest tag
#   no-tags  - upstream has no parseable stable release tag
#   exists   - a branch/PR already exists for this lang+tag
#   failed   - bump/test-lang failed, or an unexpected crash / ug.die
STATUS_UPDATED = "updated"
STATUS_NO_OP = "no-op"
STATUS_NO_TAGS = "no-tags"
STATUS_EXISTS = "exists"
STATUS_FAILED = "failed"

# A tag counts as a stable release iff it is `X.Y[.Z...]`, optionally with a
# single leading `v`. This deliberately excludes prereleases (`-rc1`, `-beta`),
# date tags, and scheme-specific names (`parser-*`) so we never propose an
# upstream version its own authors consider unstable.
_STABLE_TAG_RE = re.compile(r"^v?\d+(?:\.\d+)+$")


@dataclass(frozen=True)
class LangAndWrapper:
    language: str
    wrapper: str

    def wrapper_dir(self, root: Path) -> Path:
        """Return the semgrep-<wrapper> directory under semgrep-grammars/src."""
        return root / "lang" / "semgrep-grammars" / "src" / f"semgrep-{self.wrapper}"


@dataclass(frozen=True)
class Target:
    """Everything needed to act on a language, resolved without mutating."""
    lang: LangAndWrapper
    submodule: Path
    ts_version: str | None = None
    url: str | None = None
    tag: str | None = None
    skip_reason: str | None = None
    resolution_note: str | None = None


@dataclass
class Result:
    """Outcome of a propose run — the JSON contract emitted on stdout.

    Serialized to `result-<lang>.json` by the workflow's propose job and read
    back by its integrate job (`from_file`), so the release step acts on the
    exact tag/branch that was validated, never a re-resolved one.
    """
    language: str
    ts_version: str | None = None
    old_sha: str | None = None
    new_sha: str | None = None
    new_tag: str | None = None
    status: str | None = None
    detail: str | None = None
    test_log_tail: str = ""
    corpus_diff: str = ""
    tests_adapted: bool = False
    branch: str | None = None
    pr_url: str | None = None
    version_note: str | None = None
    agent_input_tokens: int | None = None
    agent_output_tokens: int | None = None
    agent_turns: int | None = None
    agent_capped_reason: str | None = None

    def to_json(self) -> str:
        return json.dumps({k: v for k, v in asdict(self).items() if v is not None})

    @classmethod
    def from_file(cls, path: Path) -> "Result":
        """Load a result artifact, ignoring keys this version doesn't know."""
        data = json.loads(path.read_text())
        known = {f.name for f in fields(cls)}
        return cls(**{k: v for k, v in data.items() if k in known})

###############################################################################
# Helpers #
###############################################################################

def log(msg: str) -> None:
    """Print a human-facing progress line to stderr (stdout is for JSON)."""
    print(msg, file=sys.stderr)


# Transient index.lock from concurrent status polling (IDE/Conductor).
_LOCK_ATTEMPTS = 5
_LOCK_DELAY = 0.3


def _retry_index_lock(
    run_once: Callable[[], subprocess.CompletedProcess],
    output: Callable[[subprocess.CompletedProcess], str],
) -> subprocess.CompletedProcess:
    """Run `run_once` up to `_LOCK_ATTEMPTS`, retrying only on index.lock."""
    for i in range(_LOCK_ATTEMPTS):
        r = run_once()
        if r.returncode == 0 or "index.lock" not in output(r):
            return r
        if i < _LOCK_ATTEMPTS - 1:
            time.sleep(_LOCK_DELAY)
    return r


def git_query(cmd: list[str], cwd: Path) -> subprocess.CompletedProcess:
    """Run a read-only query quietly, never raising. Use `ug.run` for mutations."""
    return subprocess.run(
        cmd, cwd=cwd, text=True, capture_output=True, check=False,
    )


def run_quiet(cmd: list[str], cwd: Path) -> None:
    """Run a mutating command, mirroring output to stderr, raising on error.

    stdout stays reserved for the Result JSON line. Retries on index.lock.
    """
    log(f"$ {' '.join(cmd)}  (in {cwd})")

    def once() -> subprocess.CompletedProcess:
        r = subprocess.run(cmd, cwd=cwd, text=True, check=False,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        sys.stderr.write(r.stdout)
        return r

    r = _retry_index_lock(once, lambda r: r.stdout)
    if r.returncode != 0:
        raise subprocess.CalledProcessError(r.returncode, cmd, r.stdout)


@dataclass(frozen=True, order=True, init=False)
class Version:
    """Comparable dotted version, optionally v-prefixed. Not full PEP 440."""
    parts: tuple[int, ...]

    def __init__(self, parts: tuple[int, ...]) -> None:
        object.__setattr__(self, "parts", parts)

    @classmethod
    def parse(cls, text: str) -> Version:
        """Parse a dotted version string (optional leading ``v``)."""
        return cls(tuple(int(part) for part in text.lstrip("vV").split(".")))

    def __str__(self) -> str:
        return ".".join(map(str, self.parts))

    def __repr__(self) -> str:
        return f"Version.parse({str(self)!r})"


def gitmodules_url(root: Path, submodule: Path) -> str | None:
    """Return the upstream URL for `submodule`, rewritten to HTTPS.

    Matches on the `path` value (section names are inconsistent) and
    rewrites SSH URLs to HTTPS so `git ls-remote` works without keys in CI.
    """
    rel = submodule.relative_to(root).as_posix()
    result = git_query(
        ["git", "config", "-f", ".gitmodules", "--get-regexp", r"\.path$"],
        cwd=root,
    )
    section = None
    for line in result.stdout.splitlines():
        key, _, path = line.partition(" ")
        if path == rel:
            section = key[: -len(".path")]
            break
    if section is None:
        return None
    url = git_query(
        ["git", "config", "-f", ".gitmodules", "--get", f"{section}.url"],
        cwd=root,
    ).stdout.strip()
    if not url:
        return None
    return url.replace("git@github.com:", "https://github.com/")


# Cap on newer-than-current tags examined per language.
MAX_TAGS_EXAMINED = 4

# tree-sitter >= 0.24 breaks C++ external scanners (scanner.cc). Cap only
# when the upstream tag still ships src/scanner.cc; no remaining
# Semgrep-owned scanner.cc fork needs a separate check.
_CPP_SCANNER_CEILING = Version.parse("0.24.0")
_CPP_SCANNER_CEILING_STR = str(_CPP_SCANNER_CEILING)

# ABI 15's only grammar-authoring feature that can't be expressed in ABI 14
# (this repo ships ABI 14 only -- see lang/generate_abi_args.py).
_RESERVED_FIELD_RE = re.compile(r"^\s*reserved\s*:", re.MULTILINE)

# Semver inside a devDependencies/peerDependencies value, e.g. "^0.25.3".
_VERSION_DIGITS_RE = re.compile(r"(\d+\.\d+\.\d+)")


@dataclass(frozen=True)
class NoStableTags:
    """Upstream has no stable release tags at all."""


@dataclass(frozen=True)
class NewerStableTags:
    """Stable tags strictly newer than the current SHA, newest first.

    An empty `tags` list means already at (or ahead of) the newest stable tag.
    """
    tags: list[str]


@dataclass(frozen=True)
class FetchedSubmodule:
    """A submodule whose tags/history are available locally. Construct via `fetch`."""
    path: Path

    @classmethod
    def fetch(cls, submodule: Path) -> FetchedSubmodule | None:
        """Unshallow if needed, then fetch all tags. Never touches HEAD/worktree."""
        if ug.is_shallow_repo(submodule):
            git_query(["git", "fetch", "origin", "--unshallow"], cwd=submodule)
        ok = git_query(
            ["git", "fetch", "--tags", "origin"], cwd=submodule,
        ).returncode == 0
        return cls(submodule) if ok else None

    def is_newer_than(self, tag: str, old_sha: str) -> bool:
        """True if `old_sha` is an ancestor of `tag` -- i.e. `tag` is newer."""
        tag_sha = git_query(
            ["git", "rev-list", "-n", "1", tag], cwd=self.path,
        ).stdout.strip()
        return (tag_sha != old_sha and
                git_query(
                    ["git", "merge-base", "--is-ancestor", old_sha, tag],
                    cwd=self.path,
                ).returncode == 0)

    def list_newer_stable_tags(
        self, url: str, old_sha: str,
    ) -> NoStableTags | NewerStableTags:
        """Return stable tags at `url` newer than `old_sha`, newest first."""
        stable = _list_stable_tags(url)
        if not stable:
            return NoStableTags()
        return NewerStableTags(
            [tag for tag in stable if self.is_newer_than(tag, old_sha)]
        )

    def read_tag_file(self, tag: str, path: str) -> str | None:
        """Return the text of `path` at `tag`, or None if absent. Never touches the worktree."""
        result = git_query(["git", "show", f"{tag}:{path}"], cwd=self.path)
        return result.stdout if result.returncode == 0 else None

    def tag_has_path(self, tag: str, path: str) -> bool:
        """True if `path` exists at `tag` in this submodule."""
        return git_query(
            ["git", "cat-file", "-e", f"{tag}:{path}"], cwd=self.path,
        ).returncode == 0


def _list_stable_tags(url: str) -> list[str]:
    """Return every stable release tag at `url`, sorted newest first."""
    # Patterns narrow server-side; regex still drops prereleases globs can't exclude.
    result = git_query(
        ["git", "ls-remote", "--tags", "--refs", url,
         "refs/tags/v[0-9]*", "refs/tags/[0-9]*"],
        cwd=Path.cwd(),
    )
    if result.returncode != 0:
        return []
    tags = [
        line.split("refs/tags/", 1)[1]
        for line in result.stdout.splitlines()
        if "refs/tags/" in line
    ]
    # Patterns above don't exclude prereleases; filter here.
    stable = [t for t in tags if _STABLE_TAG_RE.match(t)]
    return sorted(stable, key=Version.parse, reverse=True)


def latest_stable_tag(url: str) -> str | None:
    """Return the highest stable release tag at `url`, or None."""
    tags = _list_stable_tags(url)
    return tags[0] if tags else None


def _requires_abi15(fetched: FetchedSubmodule, tag: str) -> bool:
    """True if `grammar.js` at `tag` declares a top-level `reserved:` field.

    Best-effort text check; test-lang is the authoritative check.
    """
    text = fetched.read_tag_file(tag, "grammar.js")
    return bool(text and _RESERVED_FIELD_RE.search(text))


def _upstream_has_cpp_scanner(fetched: FetchedSubmodule, tag: str) -> bool:
    """True if upstream at `tag` ships a C++ external scanner (`src/scanner.cc`)."""
    return fetched.tag_has_path(tag, "src/scanner.cc")


def _is_git_tracked(root: Path, path: Path) -> bool:
    """True if `path` is tracked by git (e.g. force-added under a gitignored dir)."""
    tracked = git_query(
        ["git", "ls-files", "--", str(path.relative_to(root))],
        cwd=root,
    ).stdout.strip()
    return bool(tracked)


# Force-tracked wrapper scanner.c (kotlin, scala, ruby, …) can drift from
# upstream after a bump. No tested auto-sync path yet; surface for a human.
def _forked_scanner_c_drift_note(root: Path, lang: LangAndWrapper) -> str | None:
    """Report (do not fix) when a force-tracked wrapper scanner.c differs from upstream."""
    wrapper_scanner = lang.wrapper_dir(root) / "src" / "scanner.c"
    if not wrapper_scanner.is_file() or wrapper_scanner.is_symlink():
        return None
    upstream = (
        root / "lang" / "semgrep-grammars" / "src"
        / f"tree-sitter-{lang.language}" / "src" / "scanner.c"
    )
    # gomod and similar may use a different upstream dir name; best-effort.
    if not upstream.is_file():
        return None
    if not _is_git_tracked(root, wrapper_scanner):
        return None
    if filecmp.cmp(wrapper_scanner, upstream, shallow=False):
        return None
    return (
        f"semgrep-{lang.wrapper}/src/scanner.c (force-tracked) differs from "
        f"upstream tree-sitter-{lang.language}/src/scanner.c after this bump; "
        f"not auto-syncing — rebase the Semgrep scanner extensions manually "
        f"if test-lang fails on scanner behavior"
    )


def _declared_min_ts_version(fetched: FetchedSubmodule, tag: str) -> str | None:
    """Return upstream's declared minimum tree-sitter-cli version at `tag`, or None."""
    text = fetched.read_tag_file(tag, "package.json")
    if not text:
        return None
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return None
    for section in ("devDependencies", "peerDependencies"):
        section_data = data.get(section)
        if not isinstance(section_data, dict):
            continue
        spec = section_data.get("tree-sitter-cli")
        if spec:
            match = _VERSION_DIGITS_RE.search(spec)
            if match:
                return match.group(1)
    return None


@dataclass(frozen=True)
class VersionOk:
    """Successful resolve_tag_and_version outcome."""
    tag: str
    ts_version: str
    note: str | None = None


@dataclass(frozen=True)
class VersionErr:
    """Failed resolve_tag_and_version outcome."""
    error: str


VersionResolution = VersionOk | VersionErr


def _pick_ts_version(
    versions: list[Version], *, floor: Version | None, ceiling: Version | None,
) -> Version | None:
    """Return the newest fitting version from `versions` (pre-parsed, newest-first)."""
    for v in versions:
        if ceiling is not None and not v < ceiling:
            continue
        if floor is not None and not v >= floor:
            continue
        return v
    return None


def _version_note(chosen: Version, *, upstream_cpp: bool) -> str | None:
    """Advisory note when the chosen pin is capped by an upstream C++ scanner."""
    if not upstream_cpp:
        return None
    return (
        f"capped to {chosen}: C++ external scanner (scanner.cc) "
        f"in upstream requires tree-sitter < {_CPP_SCANNER_CEILING_STR}"
    )


def _evaluate_tag(
    fetched: FetchedSubmodule, tag: str, tree_sitter_versions: list[Version],
) -> VersionOk | str:
    """Try one tag: return VersionOk on success, or a skip-reason string."""
    if _requires_abi15(fetched, tag):
        return (
            f"{tag}: requires ABI 15 (declares 'reserved:'); "
            f"this repo builds ABI 14 only"
        )
    upstream_cpp = _upstream_has_cpp_scanner(fetched, tag)
    floor_str = _declared_min_ts_version(fetched, tag)
    floor = Version.parse(floor_str) if floor_str else None
    ceiling = _CPP_SCANNER_CEILING if upstream_cpp else None
    chosen = _pick_ts_version(
        tree_sitter_versions, floor=floor, ceiling=ceiling,
    )
    if chosen is None:
        constraints = []
        if upstream_cpp:
            constraints.append(
                f"C++ scanner (needs tree-sitter < {_CPP_SCANNER_CEILING_STR})"
            )
        if floor is not None:
            constraints.append(
                f"upstream's declared minimum {floor}"
            )
        return (
            f"{tag}: no pinned tree-sitter version satisfies "
            + " and ".join(constraints)
        )
    note = _version_note(chosen, upstream_cpp=upstream_cpp)
    return VersionOk(tag, str(chosen), note=note)


def resolve_tag_and_version(submodule: Path, url: str,
                            tree_sitter_versions: list[Version],
                            old_sha: str) -> VersionResolution:
    """Pick the newest tag newer than `old_sha` buildable at ABI 14, and the
    best pinned tree-sitter version for it.

    Walks newer stable tags (capped at MAX_TAGS_EXAMINED), skips ABI 15,
    and picks the highest pinned version compatible with the C++ scanner
    ceiling (if any) and upstream's declared tree-sitter-cli floor.
    """
    fetched = FetchedSubmodule.fetch(submodule)
    if fetched is None:
        return VersionErr("could not fetch tags from submodule")

    newer = fetched.list_newer_stable_tags(url, old_sha)
    if isinstance(newer, NoStableTags):
        return VersionErr("no stable release tag upstream")
    if not newer.tags:
        return VersionErr(
            "already at (or ahead of) the newest available upstream tag",
        )

    reasons: list[str] = []
    for tag in newer.tags[:MAX_TAGS_EXAMINED]:
        outcome = _evaluate_tag(
            fetched, tag, tree_sitter_versions,
        )
        if isinstance(outcome, VersionOk):
            return outcome
        reasons.append(outcome)

    detail = "; ".join(reasons) or "no compatible tag/tree-sitter-version pairing found"
    return VersionErr(detail)


def language_ts_version(root: Path, lang: LangAndWrapper) -> str | None:
    """Return the tree-sitter version `lang.wrapper` is listed under, or None."""
    version_files = ug.discover_version_files(root, "languages")
    for version, path in version_files.items():
        if lang.wrapper in ug.read_languages_entries(path):
            return version
    return None


def resolve_target(root: Path, lang: LangAndWrapper, tree_sitter_versions: list[Version],
                   *, deep: bool = True) -> Target:
    """Resolve a `Target` for `lang` without mutating anything.

    `deep=True` (the real propose flow) resolves tag + tree-sitter version
    via `resolve_tag_and_version`. `deep=False` (cheap pre-filter) resolves
    only the latest tag via one `ls-remote`, reusing the current pin.
    """
    submodule = ug.submodule_path(root, lang.language)
    url = gitmodules_url(root, submodule)
    # Languages absent from every languages-* file (e.g. gomod) aren't
    # proposable; record as skip_reason rather than dying.
    current_ts_version = language_ts_version(root, lang)
    skip_reason = None
    if current_ts_version is None:
        skip_reason = f"'{lang.wrapper}' is not in any lang/languages-* file"

    tag = ts_version = resolution_note = None
    if skip_reason is None and url:
        if deep:
            old_sha = submodule_head(submodule)
            resolution = resolve_tag_and_version(
                submodule, url, tree_sitter_versions, old_sha,
            )
            if isinstance(resolution, VersionErr):
                skip_reason = resolution.error
            else:
                tag, ts_version, resolution_note = (
                    resolution.tag, resolution.ts_version, resolution.note,
                )
        else:
            tag = latest_stable_tag(url)
            ts_version = current_ts_version

    return Target(
        lang=lang, submodule=submodule,
        ts_version=ts_version, url=url, tag=tag, skip_reason=skip_reason,
        resolution_note=resolution_note,
    )


def submodule_head(submodule: Path) -> str:
    """Return the submodule's current HEAD SHA."""
    return git_query(["git", "rev-parse", "HEAD"], cwd=submodule).stdout.strip()


def recorded_submodule_sha(root: Path, submodule: Path) -> str | None:
    """Return the submodule SHA recorded in the outer repo's index (HEAD).

    Reads the gitlink via `git ls-tree` — no submodule checkout needed.
    """
    rel = submodule.relative_to(root).as_posix()
    out = git_query(["git", "ls-tree", "HEAD", rel], cwd=root).stdout.split()
    return out[2] if len(out) >= 3 else None


def tag_commit_sha(url: str, tag: str) -> str | None:
    """Resolve `tag` to a commit SHA on the remote.

    Prefers the peeled `^{}` line (annotated tags' plain ref is the tag
    object, not the commit); falls back to the plain ref for lightweight tags.
    """
    out = git_query(
        ["git", "ls-remote", url, f"refs/tags/{tag}^{{}}", f"refs/tags/{tag}"],
        cwd=Path.cwd(),
    ).stdout
    peeled = plain = None
    for line in out.splitlines():
        parts = line.split()
        if len(parts) != 2:
            continue
        sha, ref = parts
        if ref.endswith("^{}"):
            peeled = sha
        else:
            plain = sha
    return peeled or plain


def is_up_to_date(root: Path, lang: LangAndWrapper) -> bool | None:
    """True if `lang`'s submodule is at its latest stable tag; None if undeterminable.

    Cheap: recorded gitlink + a remote ls-remote, no build/checkout.
    """
    target = resolve_target(root, lang, tree_sitter_versions=[], deep=False)
    if target.skip_reason or target.tag is None or not target.url:
        return None
    cur = recorded_submodule_sha(root, target.submodule)
    tag_sha = tag_commit_sha(target.url, target.tag)
    if cur is None or tag_sha is None:
        return None
    return cur == tag_sha


@contextlib.contextmanager
def _stdout_to_stderr():
    """Redirect fd 1 to fd 2 temporarily, so stdout stays a single JSON line."""
    sys.stdout.flush()
    saved_fd = os.dup(1)
    try:
        os.dup2(2, 1)
        yield
    finally:
        sys.stdout.flush()
        os.dup2(saved_fd, 1)
        os.close(saved_fd)


def ensure_ts_version_on_path(root: Path, ts_version: str) -> None:
    """Provision `ts_version`'s tree-sitter CLI and put it first on PATH."""
    with _stdout_to_stderr():
        ug.ensure_tree_sitter_version(root, ts_version)
    bin_dir = root / "core" / f"tree-sitter-{ts_version}" / "bin"
    path_entries = os.environ.get("PATH", "").split(os.pathsep)
    path_entries.insert(0, str(bin_dir))
    os.environ["PATH"] = os.pathsep.join(path_entries)


def run_update_grammar(lang: LangAndWrapper, ts_version: str, tag: str,
                       root: Path) -> subprocess.CompletedProcess:
    """Bump `language` to `tag` via `update-grammar --skip-release`.

    Subprocessed so a failure is isolated and output is captured for the
    PR body / log. `--skip-release` guarantees nothing is pushed upstream.
    """
    return subprocess.run(
        [str(_UPDATE_GRAMMAR_PATH), lang.language, ts_version,
         "--ref", tag, "--skip-release"],
        cwd=root, text=True, capture_output=True, check=False,
    )


def regenerate_snapshots(root: Path, lang: LangAndWrapper, ts_version: str) -> None:
    """Regenerate corpus snapshots for every grammar.js under the wrapper.

    A bump almost always churns parse trees; `tree-sitter test --update`
    rewrites snapshots from the new parser. Requires
    `core/tree-sitter-<version>/bin` on PATH (see `ensure_ts_version_on_path`).
    Every grammar.js is expected pinned to the same `ts_version`; a
    diverging sub-dialect is reported, not silently mis-tested.
    """
    wrapper_path = lang.wrapper_dir(root)
    grammar_dirs = {p.parent for p in wrapper_path.rglob("grammar.js")}
    for gdir in sorted(grammar_dirs):
        pinned = ts_versions.version_for_grammar_dir(gdir, root / "lang")
        if pinned != ts_version:
            raise ts_versions.TsVersionError(
                f"{gdir} is pinned to tree-sitter {pinned}, but {lang.wrapper} "
                f"was bumped to {ts_version}; a sub-dialect diverging from "
                f"its wrapper's tree-sitter version is not supported"
            )
        # --update exits non-zero on :error tests; the test-lang re-run is authoritative.
        git_query(["tree-sitter", "test", "--update"], cwd=gdir)


def corpus_diff(root: Path, lang: LangAndWrapper) -> str:
    """Return the working-tree diff of the wrapper's corpus snapshots."""
    return git_query(
        ["git", "diff", "--", str(lang.wrapper_dir(root) / "test" / "corpus")],
        cwd=root,
    ).stdout


def run_test_lang(lang: LangAndWrapper, root: Path) -> subprocess.CompletedProcess:
    """Run `./test-lang <language>` for the authoritative pass/fail."""
    return subprocess.run(
        ["./test-lang", lang.language], cwd=root / "lang",
        text=True, capture_output=True, check=False,
    )


def _git_reset_step(cmd: list[str], cwd: Path) -> None:
    """Best-effort reset step, retrying only on index.lock."""
    _retry_index_lock(lambda: git_query(cmd, cwd), lambda r: r.stderr)


def reset_language_state(root: Path, submodule: Path, old_sha: str) -> None:
    """Undo every mutation so a failure never leaks into the next run.

    Restores the submodule to `old_sha` and the outer tree to HEAD.
    """
    _git_reset_step(["git", "restore", "--staged", "."], root)
    _git_reset_step(["git", "checkout", "--", "lang"], root)
    _git_reset_step(["git", "checkout", old_sha], submodule)
    _git_reset_step(["git", "checkout", "--", "."], submodule)
    _git_reset_step(["git", "clean", "-fdq"], submodule)


def tail(text: str, lines: int = 40) -> str:
    """Return the last `lines` lines of `text`."""
    return "\n".join(text.splitlines()[-lines:])


def base_branch() -> str:
    """Branch the grammar-update PR is opened against / forked from.

    Defaults to `main`; override with GRAMMAR_BASE_BRANCH. Validated so an
    env-injected value can't smuggle git options or ref tricks.
    """
    base = os.environ.get("GRAMMAR_BASE_BRANCH", "main")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]*", base):
        ug.die(f"invalid GRAMMAR_BASE_BRANCH: {base!r}")
    return base


def branch_name(lang: LangAndWrapper, tag: str) -> str:
    """Branch for a lang+tag proposal, keyed on the tag so re-runs are idempotent."""
    return f"grammar-update/{lang.language}/{tag}"


def proposal_exists(root: Path, branch: str) -> bool:
    """True if `branch` exists locally or on origin — cheap pre-check for a re-run."""
    remote = git_query(
        ["git", "ls-remote", "--heads", "origin", branch], cwd=root,
    ).stdout.strip()
    if remote:
        return True
    local = git_query(
        ["git", "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"],
        cwd=root,
    )
    return local.returncode == 0


def existing_proposal(root: Path, target: Target) -> Result | None:
    """Result for an already-proposed lang+tag, or None. Runs before the expensive build."""
    if target.tag is None:
        return None
    branch = branch_name(target.lang, target.tag)
    if not proposal_exists(root, branch):
        return None
    return Result(language=target.lang.language, ts_version=target.ts_version,
                  new_tag=target.tag, status=STATUS_EXISTS, branch=branch,
                  detail=f"branch {branch} already exists")


def compare_url(url: str, old_sha: str, new_tag: str) -> str:
    """GitHub compare link old_sha...new_tag for the upstream repo."""
    base = url.removesuffix(".git")
    return f"{base}/compare/{old_sha}...{new_tag}"


def pr_body(result: Result, url: str) -> str:
    """Build the PR description from a propose() result."""
    old, new, tag = result.old_sha, result.new_sha, result.new_tag
    diff = result.corpus_diff.strip()
    diff_section = (
        f"<details><summary>Corpus snapshot diff</summary>\n\n"
        f"```diff\n{diff}\n```\n</details>"
        if diff else "_No corpus snapshot changes._"
    )
    log_tail = result.test_log_tail.strip()
    log_section = (
        f"<details><summary>test-lang output (tail)</summary>\n\n"
        f"```\n{log_tail}\n```\n</details>"
        if log_tail else ""
    )
    adapted_note = (
        "> ⚠️ **An agent adapted existing tests** for this bump (test-lang "
        "failed on the raw bump, typically a mechanical upstream CST rename). "
        "Scrutinize the test changes in the diff.\n\n"
        if result.tests_adapted else ""
    )
    version_note = (
        f"> ℹ️ **Tree-sitter version note:** {result.version_note}\n\n"
        if result.version_note else ""
    )
    return (
        f"Automated grammar update for **{result.language}**.\n\n"
        f"- Upstream: {url}\n"
        f"- `{old}` → `{new}` (**{tag}**)\n"
        f"- tree-sitter version: `{result.ts_version}`\n"
        f"- Compare: {compare_url(url, old, tag)}\n\n"
        f"Corpus snapshots were auto-regenerated. **Please review** the parse-tree "
        f"changes below — especially any `:error` (error-recovery) cases, which "
        f"`tree-sitter test --update` does not touch automatically.\n\n"
        f"{version_note}"
        f"{adapted_note}"
        f"{diff_section}\n\n{log_section}\n\n"
        f"🤖 Generated with [Claude Code](https://claude.com/claude-code)"
    )


AGENT_ADAPTED_LABEL = "agent-adapted-tests"


def open_pr(root: Path, target: Target, result: Result,
            dry_run: bool) -> Result:
    """Push the branch `propose(keep=True)` built and open a PR for it."""
    lang, tag = target.lang, result.new_tag
    base = base_branch()
    branch = result.branch or branch_name(lang, tag)
    result.branch = branch
    title = f"Update tree-sitter-{lang.language} grammar to {tag}"
    body = pr_body(result, target.url)

    if dry_run:
        log(f"\n=== would push branch: {branch}")
        log(f"=== would create PR (base {base}): {title}\n")
        log(body)
        result.status = "dry-run"
        return result

    run_quiet(["git", "push", "origin", branch], cwd=root)
    create = ["gh", "pr", "create", "--title", title, "--body", body,
              "--base", base, "--head", branch]
    if result.tests_adapted:
        ensure_label(origin_repo(), AGENT_ADAPTED_LABEL)
        create += ["--label", AGENT_ADAPTED_LABEL]
    # Captured (not run_quiet) so the PR URL lands in the result JSON.
    log(f"$ {' '.join(create)}  (in {root})")
    created = subprocess.run(create, cwd=root, text=True,
                             capture_output=True, check=False)
    sys.stderr.write(created.stdout)
    sys.stderr.write(created.stderr)
    if created.returncode != 0:
        raise subprocess.CalledProcessError(created.returncode, create,
                                            created.stdout)
    url = created.stdout.strip().splitlines()[-1] if created.stdout.strip() else ""
    if url.startswith("https://"):
        result.pr_url = url
    return result


def language_agent_prompt(lang: LangAndWrapper, tag: str,
                        test_log: str) -> str:
    """Prompt that drives the `fix-semgrep-grammar` skill.

    That skill is the purpose-built tool for repairing the grammar + corpus
    after a bump; the authoritative signal remains the caller's test-lang
    re-run afterward.
    """
    return (
        f"Use the `fix-semgrep-grammar` skill to make `test-lang {lang.language}` "
        f"pass. Context: the tree-sitter-{lang.language} submodule was just bumped "
        f"to {tag} and test-lang now fails. Follow the skill's edit boundaries "
        f"and exit contract exactly; do not commit, push, or open a PR — leave "
        f"the working tree changed for the outer pipeline. Print the skill's "
        f"final FIX-SEMGREP-GRAMMAR status line.\n\n"
        f"Failing test-lang output:\n{tail(test_log, 60)}"
    )


def _dispatch_language_agent(
    root: Path, result: Result, prompt: str, *, label: str,
    verbose: bool, agent_timeout: float,
    agent_token_cap: int | None, agent_turn_cap: int | None,
) -> None:
    """Run the Cursor language agent and record its usage onto `result`."""
    agent_result = run_language_agent(
        root, prompt, label=label, verbose=verbose,
        timeout_seconds=agent_timeout,
        token_cap=agent_token_cap, turn_cap=agent_turn_cap,
    )
    result.agent_input_tokens = agent_result.input_tokens
    result.agent_output_tokens = agent_result.output_tokens
    result.agent_turns = agent_result.turns
    result.agent_capped_reason = agent_result.capped_reason


def propose(root: Path, target: Target, keep: bool = False,
            language_agent: bool = False, verbose: bool = False,
            agent_timeout: float = 1500.0,
            agent_token_cap: int | None = DEFAULT_AGENT_TOKEN_CAP,
            agent_turn_cap: int | None = DEFAULT_AGENT_TURN_CAP) -> Result:
    """Run the full single-language propose flow; return a Result.

    Bumps to the latest tag, regenerates snapshots, runs test-lang, and
    classifies the outcome. With `language_agent=True`, a test-lang failure
    triggers fix-semgrep-grammar then a re-test. With `keep=True`, the work
    happens on the grammar-update branch and the validated tree is
    committed there for `open_pr()` to push; `keep=False` resets the tree
    before returning. Never creates a PR itself.
    """
    lang = target.lang
    language = lang.language
    step = lambda msg: log(f"[{language}] {msg}")
    tag = target.tag
    result = Result(language=language, ts_version=target.ts_version, new_tag=tag)
    if target.resolution_note:
        result.version_note = target.resolution_note

    if target.skip_reason:
        result.status = STATUS_NO_TAGS
        result.detail = target.skip_reason
        return result
    if tag is None:
        result.status = STATUS_NO_TAGS
        result.detail = "no stable release tag upstream"
        return result

    submodule = target.submodule
    old_sha = submodule_head(submodule)
    result.old_sha = old_sha
    step(f"{old_sha[:8]} -> {tag}")

    # keep mode: work directly on the grammar-update branch, don't reset —
    # the validated tree becomes the PR commit. Classify-only: reset after.
    branch = branch_name(lang, tag)
    committed = False
    try:
        if keep:
            base = base_branch()
            log(f"[{language}] checking out {branch} from origin/{base}")
            run_quiet(["git", "fetch", "origin", base], cwd=root)
            run_quiet(["git", "checkout", "-B", branch, f"origin/{base}"], cwd=root)

        # A non-zero bump with a moved submodule is expected (stale snapshots
        # fail update-grammar's own test-lang); our re-run below is authoritative.
        step(f"bumping submodule to {tag}")
        bump = run_update_grammar(lang, target.ts_version, tag, root)
        new_sha = submodule_head(submodule)
        result.new_sha = new_sha

        if new_sha == old_sha:
            if bump.returncode != 0:
                result.status = STATUS_FAILED
                result.detail = "update-grammar failed"
                result.test_log_tail = tail(bump.stdout + bump.stderr)
                step("update-grammar failed; nothing moved")
                return result
            result.status = STATUS_NO_OP
            step(f"already at {tag}; no-op")
            return result

        drift = _forked_scanner_c_drift_note(root, lang)
        if drift:
            step(drift)
            result.version_note = (
                f"{result.version_note}; {drift}" if result.version_note else drift
            )

        step("regenerating corpus snapshots")
        regenerate_snapshots(root, lang, target.ts_version)
        result.corpus_diff = corpus_diff(root, lang)
        step("running test-lang")
        test = run_test_lang(lang, root)
        result.test_log_tail = tail(test.stdout + test.stderr)

        if test.returncode != 0 and language_agent:
            # Usually a mechanical CST rename broke corpus snapshots; adapt
            # via fix-semgrep-grammar, then re-test as the authoritative signal.
            step("test-lang failed; dispatching fix-semgrep-grammar")
            prompt = language_agent_prompt(lang, tag, test.stdout + test.stderr)
            _dispatch_language_agent(
                root, result, prompt, label=language, verbose=verbose,
                agent_timeout=agent_timeout, agent_token_cap=agent_token_cap,
                agent_turn_cap=agent_turn_cap,
            )
            result.corpus_diff = corpus_diff(root, lang)
            step("re-running test-lang after language agent")
            test = run_test_lang(lang, root)
            result.test_log_tail = tail(test.stdout + test.stderr)
            if test.returncode == 0:
                result.tests_adapted = True

        if test.returncode != 0:
            result.status = STATUS_FAILED
            result.detail = ("test-lang failed (language agent could not fix it)"
                             if language_agent else
                             "test-lang failed (language agent not enabled)")
            if not result.test_log_tail:
                result.test_log_tail = tail(bump.stdout + bump.stderr)
            step(f"{result.detail}")
            return result

        result.status = STATUS_UPDATED
        if keep:
            # Commit exactly what was tested; exclude the result artifact
            # and core/ (provisioning dirtiness that must never be staged).
            step(f"committing validated tree on {branch}")
            run_quiet(["git", "add", "-A", "--", ".",
                       ":(exclude)result-*.json", ":(exclude)core"], cwd=root)
            run_quiet(["git", "commit", "-m",
                       f"Update tree-sitter-{lang.language} grammar to {tag}"], cwd=root)
            committed = True
            result.branch = branch
        step(f"updated: {tag}")
        return result
    except Exception as e:
        result.status = STATUS_FAILED
        result.detail = f"unexpected error: {type(e).__name__}: {e}"
        log(f"[{language}] {result.detail}")
        return result
    finally:
        # Keep a committed branch; reset otherwise so no broken branch lingers.
        if not (keep and committed):
            reset_language_state(root, submodule, old_sha)


###############################################################################
# Downstream: release to semgrep-<lang> #
###############################################################################


def github_org() -> str:
    """Org owning the semgrep-<dialect> repos, validated as an owner name."""
    org = os.environ.get("GITHUB_ORG", "semgrep")
    if not re.fullmatch(r"[A-Za-z0-9-]+", org):
        ug.die(f"invalid GITHUB_ORG: {org!r}")
    return org


def downstream_repo_exists(dialect: str) -> bool:
    """True if a semgrep-<dialect> repo exists to release into.

    Not every test-lang dialect has its own repo (e.g. php-only, sfapex);
    releasing to one without would fail, so callers filter to existing ones.
    """
    return git_query(
        ["gh", "repo", "view", f"{github_org()}/semgrep-{dialect}",
         "--json", "name"],
        cwd=Path.cwd(),
    ).returncode == 0


def origin_repo() -> str:
    """Return this repo as owner/name (for gh cross-repo references)."""
    return git_query(
        ["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],
        cwd=Path.cwd(),
    ).stdout.strip()


def ensure_label(repo: str, label: str) -> None:
    """Create `label` in `repo` if missing (idempotent; ignores 'exists')."""
    git_query(
        ["gh", "label", "create", label, "--repo", repo,
         "--color", "B60205", "--description",
         "An agent adapted test expectations for this grammar bump",
         "--force"],
        cwd=Path.cwd(),
    )


def release_dialects(lang: LangAndWrapper) -> list[str]:
    """Dialects to release for a language, filtered to existing repos.

    `lang/release` operates per dialect (e.g. typescript -> [typescript, tsx]);
    falls back to the language itself if no dialect repo exists.
    """
    dialects = ug.LANGUAGE_VARIANTS.get(lang.wrapper, [lang.language])
    existing = [d for d in dialects if downstream_repo_exists(d)]
    return existing or [lang.language]


def open_downstream_pr(dialect: str, branch: str, tag: str,
                       *, dry_run: bool) -> None:
    """Open a PR on semgrep-<dialect> for the released branch (idempotent).

    The default branch is protected, so the change lands via review.
    """
    repo = f"{github_org()}/semgrep-{dialect}"
    if dry_run:
        log(f"[dry run] would open PR on {repo} for {branch}")
        return
    existing = git_query(
        ["gh", "pr", "list", "--repo", repo, "--head", branch,
         "--state", "all", "--json", "number", "-q", ".[0].number"],
        cwd=Path.cwd(),
    ).stdout.strip()
    if existing:
        log(f"{repo}: PR already exists for {branch} (#{existing})")
        return
    title = f"Update generated {dialect} parser for {tag}"
    body = ("Automated: regenerated parser from the tree-sitter-"
            f"{dialect} {tag} grammar bump.\n\n"
            "🤖 Generated with [Claude Code](https://claude.com/claude-code)")
    run_quiet(
        ["gh", "pr", "create", "--repo", repo, "--head", branch,
         "--title", title, "--body", body],
        cwd=Path.cwd(),
    )


def release_downstream(root: Path, lang: LangAndWrapper, branch: str,
                       tag: str, *, dry_run: bool) -> subprocess.CompletedProcess:
    """Release the generated parser to each semgrep-<dialect> repo, via PR.

    The only step that touches downstream repos; gated behind --release,
    --dry-run safe.
    """
    lang_dir = root / "lang"
    last = None
    for dialect in release_dialects(lang):
        cmd = ["./release", dialect, "--branch", branch]
        if dry_run:
            cmd.append("--dry-run")
        log(f"$ {' '.join(cmd)}  (in {lang_dir})")
        # Capture (don't inherit) so output goes to stderr, not stdout JSON.
        last = subprocess.run(
            cmd, cwd=lang_dir, text=True, capture_output=True, check=False,
        )
        sys.stderr.write(last.stdout)
        sys.stderr.write(last.stderr)
        if last.returncode != 0:
            return last
        open_downstream_pr(dialect, branch, tag, dry_run=dry_run)
    return last  # type: ignore[return-value]


###############################################################################
# Entry point #
###############################################################################


def list_languages(root: Path, as_json: bool, updatable_only: bool = False) -> None:
    """Print proposable languages (sorted).

    With `updatable_only`, emit only languages behind their latest stable
    tag — keeps up-to-date languages out of the build matrix. Languages
    whose status can't be cheaply determined are included so the full
    flow decides, rather than wrongly skipping them.
    """
    valid = ug.discover_valid_languages(root)
    names = sorted(valid)
    if updatable_only:
        kept = []
        for name in names:
            lang = LangAndWrapper(language=name, wrapper=valid[name])
            up = is_up_to_date(root, lang)
            if up is True:
                log(f"skip {name}: already at latest tag")
            else:
                kept.append(name)
        names = kept
    if as_json:
        print(json.dumps(names))
    else:
        print("\n".join(names))


_RESULT_FILENAME_RE = re.compile(r"^result-(.+)\.json$")


def language_from_result_path(path: Path) -> str | None:
    """Best-effort language name from a `result-<lang>.json` artifact path."""
    m = _RESULT_FILENAME_RE.match(path.name)
    return m.group(1) if m else None


def load_result_row(path: Path) -> dict[str, Any]:
    """Load one result artifact; empty/invalid files become a failed row."""
    fallback_lang = language_from_result_path(path) or path.stem
    try:
        text = path.read_text().strip()
    except OSError as e:
        return {"language": fallback_lang, "status": STATUS_FAILED,
                "detail": f"unreadable result artifact: {e}"}
    if not text:
        return {"language": fallback_lang, "status": STATUS_FAILED,
                "detail": "empty result artifact (propose crashed before emitting JSON)"}
    try:
        r = json.loads(text)
    except json.JSONDecodeError as e:
        return {"language": fallback_lang, "status": STATUS_FAILED,
                "detail": f"invalid result JSON: {e}"}
    if not isinstance(r, dict):
        return {"language": fallback_lang, "status": STATUS_FAILED,
                "detail": "invalid result JSON: expected an object"}
    if not r.get("language"):
        r["language"] = fallback_lang
    if not r.get("status"):
        r["status"] = "unknown"
    return r


def _is_valid_result_file(path: Path) -> bool:
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return False
    return isinstance(data, dict) and bool(data.get("language")) and bool(data.get("status"))


def ensure_result_file(path: Path) -> None:
    """CI fallback: rewrite `path` as a failed row if it's missing/invalid,
    so summarize/Slack see the language instead of a silently dropped artifact.
    """
    if not _is_valid_result_file(path):
        path.write_text(json.dumps(load_result_row(path)) + "\n")


def summarize(results_dir: Path) -> None:
    """Render a markdown table from per-language result JSON files.

    Empty/corrupt artifacts become failed rows (not omitted).
    """
    rows = [load_result_row(path) for path in sorted(results_dir.rglob("*.json"))]

    by_status: dict[str, list[dict[str, Any]]] = {}
    for r in rows:
        by_status.setdefault(r["status"], []).append(r)

    order = [STATUS_UPDATED, STATUS_EXISTS, STATUS_NO_OP, STATUS_NO_TAGS, STATUS_FAILED]
    icon = {STATUS_UPDATED: "✅", STATUS_EXISTS: "↩️", STATUS_NO_OP: "➖",
            STATUS_NO_TAGS: "🏷️", STATUS_FAILED: "❌"}

    print("## Grammar update proposals\n")
    print("| Language | Status | Detail |")
    print("|---|---|---|")
    if not rows:
        print("| — | — | no result artifacts |")
        return
    for status in order + [s for s in by_status if s not in order]:
        for r in sorted(by_status.get(status, []), key=lambda x: x["language"]):
            detail = r.get("detail") or (
                f"{(r.get('old_sha') or '')[:8]} → {r.get('new_tag') or ''}"
                if status == STATUS_UPDATED else ""
            )
            # Slack/code-block tables break on raw pipes/newlines in cells.
            # Slack/code-block tables break on raw pipes/newlines in cells.
            detail = str(detail).replace("|", "\\|").replace("\n", " ")
            print(f"| {r['language']} | {icon.get(status, '')} {status} | {detail} |")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    """Parse CLI args."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("language", nargs="?", help="Language to propose an update for.")
    parser.add_argument(
        "--list-languages", action="store_true",
        help="Print the set of proposable languages and exit.",
    )
    parser.add_argument(
        "--updatable-only", action="store_true",
        help="With --list-languages, emit only languages whose submodule is "
             "behind its latest stable tag (cheap pre-filter; skips the build "
             "matrix for up-to-date languages).",
    )
    parser.add_argument(
        "--summarize", metavar="DIR",
        help="Render a markdown summary from result JSON files under DIR.",
    )
    parser.add_argument(
        "--ensure-result", metavar="FILE",
        help="CI fallback: rewrite FILE as a failed-status row if it's "
             "missing/empty/invalid (propose crashed before writing it).",
    )
    parser.add_argument(
        "--json", action="store_true",
        help="With --list-languages, emit a JSON array.",
    )
    parser.add_argument(
        "--resolve-tag-only", action="store_true",
        help="Print the latest stable tag for the language and exit.",
    )
    parser.add_argument(
        "--open-pr", action="store_true",
        help="Create the PR (default: dry run, emit JSON result only).",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="Print would-be PR / release actions instead of running them.",
    )
    parser.add_argument(
        "--language-agent", action="store_true",
        help="Dispatch a Cursor agent with fix-semgrep-grammar if test-lang "
             "fails. OFF by default (needs CURSOR_API_KEY).",
    )
    parser.add_argument(
        "--verbose", action="store_true",
        help="With --language-agent, log the full event stream instead of a "
             "heartbeat (can be very noisy).",
    )
    parser.add_argument(
        "--agent-timeout", type=parse_duration_seconds,
        default=parse_duration_seconds(DEFAULT_AGENT_TIMEOUT),
        metavar="DURATION",
        help="With --language-agent: wall-clock cap for the agent, e.g. '30s', "
             f"'25m', '2h' (default: {DEFAULT_AGENT_TIMEOUT}).",
    )
    parser.add_argument(
        "--agent-token-cap", type=int, default=DEFAULT_AGENT_TOKEN_CAP,
        metavar="N",
        help="With --language-agent: best-effort token cap, enforced at turn "
             f"boundaries only; 0 disables (default: {DEFAULT_AGENT_TOKEN_CAP}).",
    )
    parser.add_argument(
        "--agent-turn-cap", type=int, default=DEFAULT_AGENT_TURN_CAP,
        metavar="N",
        help="With --language-agent: completed-turn cap; 0 disables "
             f"(default: {DEFAULT_AGENT_TURN_CAP}).",
    )
    parser.add_argument(
        "--release", action="store_true",
        help="Downstream step: push the generated parser to the "
             "grammar-update/<lang>/<tag> branch on semgrep-<lang> and open a "
             "PR there. Run this AFTER the this-repo PR branch exists. Needs "
             "downstream push creds. (semgrep-proprietary integration is "
             "deliberately NOT handled here — that stays with the existing "
             "Cursor workflow on that repo.)",
    )
    parser.add_argument(
        "--result", metavar="FILE",
        help="With --release, read the validated tag/branch from this "
             "result-<lang>.json artifact (written by the propose job) "
             "instead of re-resolving the tag live — guarantees the release "
             "matches what test-lang validated.",
    )
    return parser.parse_args(argv)


def run_release(root: Path, target: Target, dry_run: bool,
                result_file: str | None = None) -> int:
    """Downstream hand-off: release the validated parser to semgrep-<lang>.

    Checks out the already-validated grammar-update/<lang>/<tag> branch
    (never re-bumps) and releases it via PR. With `result_file`, tag/branch
    come from the propose job's artifact — the exact ones test-lang
    validated; without it the tag is re-resolved live.
    """
    language, wrapper = target.lang.language, target.lang.wrapper
    if result_file:
        res = Result.from_file(Path(result_file))
        tag = res.new_tag
        branch = res.branch or (branch_name(target.lang, tag) if tag else None)
    else:
        tag = target.tag
        branch = branch_name(target.lang, tag) if tag else None
    if tag is None or branch is None:
        ug.die(f"{language}: no validated tag/branch; nothing to release.")

    # Do NOT re-bump — that could pull different content than what test-lang
    # validated. `lang/release` regenerates the OCaml sources from this tree.
    run_quiet(["git", "fetch", "origin", branch], cwd=root)
    run_quiet(["git", "checkout", branch], cwd=root)
    run_quiet(["git", "submodule", "update", "--init", "--recursive", "--depth", "1",
               "--", str(target.submodule.relative_to(root))], cwd=root)

    rel = release_downstream(root, target.lang, branch, tag, dry_run=dry_run)
    if rel is not None and rel.returncode != 0:
        ug.die(f"{language}: lang/release failed.")

    log(f"{language}: released to semgrep-{wrapper} branch {branch} "
        f"(PR opened per dialect).")
    print(json.dumps({"language": language, "new_tag": tag,
                      "branch": branch, "released": not dry_run}))
    return 0


def main() -> int:
    """Drive a single-language proposal; see module docstring."""
    root = ug.repo_root()
    args = parse_args()

    if args.list_languages:
        list_languages(root, args.json, updatable_only=args.updatable_only)
        return 0

    if args.summarize:
        summarize(Path(args.summarize))
        return 0

    if args.ensure_result:
        ensure_result_file(Path(args.ensure_result))
        return 0

    if not args.language:
        ug.die("a language is required (or use --list-languages).")

    try:
        # Parse once; _pick_ts_version compares these directly.
        tree_sitter_versions = sorted(
            (Version.parse(v) for v in ug.discover_version_files(root, "languages")),
            reverse=True,
        )
        if not tree_sitter_versions:
            ug.die("no supported tree-sitter versions found in lang/languages-* files")

        # Dies if the language is unknown.
        valid = ug.discover_valid_languages(root)
        wrapper = ug.validate_language(args.language, valid)

        # Before network work; --resolve-tag-only never provisions anything.
        if not args.resolve_tag_only:
            ug.require_provision_script(root)

        # Determine what to update the language to.
        lang = LangAndWrapper(language=args.language, wrapper=wrapper)
        target = resolve_target(root, lang, tree_sitter_versions)

        if args.resolve_tag_only:
            if target.tag is None:
                log(f"{lang.language}: no stable release tag found.")
                return 1
            print(target.tag)
            return 0

        # Every path below shells out to test-lang/release/update-grammar,
        # each invoking a bare `tree-sitter`; put the right one on PATH once.
        if target.ts_version:
            ensure_ts_version_on_path(root, target.ts_version)

        if args.release:
            return run_release(root, target, args.dry_run, result_file=args.result)

        if args.language_agent:
            ensure_cursor_sdk()

        # keep=True only for a real --open-pr run; dry runs exercise the full
        # pipeline on purpose. In keep mode, bail cheaply if already proposed.
        keep = args.open_pr and not args.dry_run
        result = existing_proposal(root, target) if keep else None
        if result is None:
            result = propose(root, target, keep=keep, language_agent=args.language_agent,
                             verbose=args.verbose, agent_timeout=args.agent_timeout,
                             agent_token_cap=cap_or_none(args.agent_token_cap),
                             agent_turn_cap=cap_or_none(args.agent_turn_cap))

        # Only a green, real update is worth a PR; others reported as-is.
        if (args.open_pr or args.dry_run) and result.status == STATUS_UPDATED:
            result = open_pr(root, target, result, dry_run=args.dry_run)

        print(result.to_json())
        return 0 if result.status != STATUS_FAILED else 1
    except SystemExit as e:
        # ug.die raises SystemExit(str); Exception won't catch it.
        if e.code in (0, None):
            raise
        detail = e.code if isinstance(e.code, str) else f"unexpected error: SystemExit: {e.code}"
        log(detail)
        print(Result(
            language=args.language, status=STATUS_FAILED, detail=detail,
        ).to_json())
        return 1 if not isinstance(e.code, int) else e.code
    except Exception as e:
        detail = f"unexpected error: {type(e).__name__}: {e}"
        log(detail)
        print(Result(
            language=args.language, status=STATUS_FAILED, detail=detail,
        ).to_json())
        return 1


def cli() -> None:
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    cli()
