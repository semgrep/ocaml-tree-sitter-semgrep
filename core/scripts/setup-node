#! /usr/bin/env bash
#
# Install Node.js needed for tree-sitter grammar generation.
#

# Nothing to do where these already ship. On GitHub Actions runners node 22
# lives in /usr/local/bin, which precedes apt's /usr/bin/node, so installing the
# distro package costs ~70s per job and the result is never the node that runs.
# (python3 is only installed by the apk branch below, hence checking both.)
if command -v node > /dev/null 2>&1 && command -v python3 > /dev/null 2>&1; then
  echo "node is already installed: $(command -v node) ($(node --version))"
  exit 0
fi

cat >> ~/.bashrc <<"EOF"
export PATH="$HOME/.node/bin:$PATH"
export NODE_PATH="$HOME/.node/lib/node_modules:$NODE_PATH"
export MANPATH="$HOME/.node/share/man:$MANPATH"
EOF

if which apt-get > /dev/null 2>&1; then
  sudo apt-get update
  sudo apt-get install -y nodejs
elif which apk > /dev/null 2>&1; then
  sudo apk update
  sudo apk add nodejs python3
else
  echo "$0: Unknown or unsupported package manager." >&2
  exit 1
fi

echo "node is: $(which node)"
echo "node version: $(node --version)"
